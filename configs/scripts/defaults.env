# Shared shell-script defaults for standalone mp_logger automation.
#
# Keep operator-tunable script defaults here instead of embedding fallback
# values in scripts. Existing environment variables still take precedence.

: "${MP_LOGGER_SCRIPT_DEFAULT_BUILD_DIR:=build/local-debug}"
: "${MP_LOGGER_SCRIPT_DEFAULT_BENCHMARK_BUILD_DIR:=build/local-bench}"
: "${MP_LOGGER_SCRIPT_DEFAULT_RELEASE_BUILD_DIR:=build/release}"
: "${MP_LOGGER_SCRIPT_DEFAULT_INSTALL_DIR:=dist/install}"
: "${MP_LOGGER_SCRIPT_DEFAULT_BUILD_VERSION_CONFIG:=configs/logger.bootstrap.ini}"
: "${MP_LOGGER_SCRIPT_DEFAULT_REPORT_DIR:=.tmp/reports}"
: "${MP_LOGGER_SCRIPT_DEFAULT_PARENT_TMP_ROOT:=../../.tmp}"
: "${MP_LOGGER_SCRIPT_DEFAULT_TEMP_SUBDIR:=temp}"
: "${MP_LOGGER_SCRIPT_DEFAULT_GO_BUILD_SUBDIR:=go-build}"
: "${MP_LOGGER_SCRIPT_DEFAULT_DEBUG_BUILD_TYPE:=Debug}"
: "${MP_LOGGER_SCRIPT_DEFAULT_RELEASE_BUILD_TYPE:=Release}"
: "${MP_LOGGER_SCRIPT_DEFAULT_BUILD_TESTS_ON:=ON}"
: "${MP_LOGGER_SCRIPT_DEFAULT_BUILD_TESTS_OFF:=OFF}"
: "${MP_LOGGER_SCRIPT_DEFAULT_BUILD_BENCHMARKS_ON:=ON}"
: "${MP_LOGGER_SCRIPT_DEFAULT_GIT_HOOKS_PATH:=.githooks}"
: "${MP_LOGGER_SCRIPT_DEFAULT_STATIC_THRESHOLD:=85}"
: "${MP_LOGGER_SCRIPT_DEFAULT_BENCHMARK_REPORT:=benchmark-results.md}"
: "${MP_LOGGER_SCRIPT_DEFAULT_LLM_REPORT:=llm-gap-review.md}"
: "${MP_LOGGER_SCRIPT_DEFAULT_STATIC_REPORT:=static-validation.md}"
: "${MP_LOGGER_SCRIPT_DEFAULT_STATIC_DETAIL:=static-validation.tsv}"
